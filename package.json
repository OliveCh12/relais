{
  "name": "relais",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "bash scripts/start-ios.sh",
    "android": "bash scripts/start-android.sh",
    "web": "expo start --web",
    "prebuild": "expo prebuild --no-install --no-clean",
    "build:ios": "bash scripts/build-ios.sh",
    "build:android": "bash scripts/build-android.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:boundaries && pnpm format:check",
    "bundle": "expo export --platform all",
    "doctor": "expo-doctor",
    "spike:signaling": "tsx scripts/spike-signaling.ts"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/material-symbols": "0.1.1",
    "@expo/ui": "57.0.17",
    "expo": "57.0.21",
    "expo-build-properties": "57.0.17",
    "expo-camera": "57.0.4",
    "expo-constants": "57.0.17",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.18",
    "expo-keep-awake": "57.0.1",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.20",
    "expo-secure-store": "57.0.3",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-qrcode-svg": "6.3.24",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.2.3",
    "react-native-web": "0.21.2",
    "react-native-webrtc": "124.0.8",
    "react-native-worklets": "0.10.1",
    "relais-camera-engine": "workspace:*",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
